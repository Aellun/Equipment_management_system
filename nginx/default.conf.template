upstream frontend {
    server frontend:3000;
}

upstream backend {
    server backend:8000;
}

# --- Rate-limit zones (defined in http context via conf.d include) ----------
# Admin/staff login: aggressive, to throttle brute force.
limit_req_zone $binary_remote_addr zone=staff_login:10m rate=5r/m;
# Customer login: lenient, so genuine shoppers aren't blocked.
limit_req_zone $binary_remote_addr zone=customer_login:10m rate=20r/m;

# Shared secret injected on every upstream request so the backend can tell
# gateway traffic from direct hits. MUST match the backend's GATEWAY_SECRET —
# which is why this file is a template: the nginx image's entrypoint runs
# envsubst over it at startup and fills ${GATEWAY_SECRET} from the environment,
# so the real secret lives in .env and never in git.
# proxy_set_header overwrites any client-supplied copy (inject + strip).
map $host $gateway_secret { default "${GATEWAY_SECRET}"; }

server {
    listen 80;
    client_max_body_size 20M;

    # --- Honeypot: classic scanner probes get a blank 200, not 403/404, so an
    # attacker can't distinguish this host from one with no such panel. NOTE:
    # /admin is intentionally absent — it is this app's real (authenticated)
    # admin route.
    location ~* ^/(wp-admin|wp-login\.php|xmlrpc\.php|administrator|phpmyadmin|\.env|\.git) {
        return 200 "";
        default_type text/plain;
    }

    # --- Staff login: strict rate limit -----------------------------------
    location = /api/auth/login {
        limit_req zone=staff_login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://backend/auth/login;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Gateway-Secret $gateway_secret;
    }

    # --- Customer login: lenient rate limit -------------------------------
    location = /api/shop/auth/login {
        limit_req zone=customer_login burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://backend/shop/auth/login;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Gateway-Secret $gateway_secret;
    }

    # API requests — strip /api prefix and forward to FastAPI
    location /api/ {
        proxy_pass http://backend/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Gateway-Secret $gateway_secret;
        proxy_read_timeout 120s;
        # API data (inventory, pricing, orders, PII) must never be cached.
        add_header Cache-Control "no-store" always;
    }

    # Operations consoles (/ops/services, /ops/hygiene) — never cache. The
    # hygiene console lists B2B supply enquiries, which carry prospective-client
    # contact details.
    location /ops {
        proxy_pass http://frontend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        add_header Cache-Control "no-store" always;
    }

    # Admin console — never cache (prevents stale inventory/pricing/PII).
    location /admin {
        proxy_pass http://frontend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        add_header Cache-Control "no-store" always;
    }

    # Next.js HMR WebSocket (hot reload in dev)
    location /_next/webpack-hmr {
        proxy_pass http://frontend/_next/webpack-hmr;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }

    # Everything else — Next.js frontend
    location / {
        proxy_pass http://frontend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 120s;
    }
}

# Copy to `.env` (same folder as docker-compose.yml) and fill in what you need.
# `.env` is gitignored. After editing:  docker compose up -d backend
#
# Everything here is optional — the stack runs without it.

# ── Secrets ──────────────────────────────────────────────────────
# SECRET_KEY=change-me-to-a-long-random-string
# GATEWAY_SECRET=change-me-too

# ── Social login (see SOCIAL_LOGIN.md) ───────────────────────────
# All provider buttons are always shown on the sign-in screens; a provider goes
# from greyed-out "Soon" to actually usable once both its id and secret are
# filled in below. Check what is live with:
#     curl http://localhost/api/errands/auth/providers
#
# Register this redirect URI with every provider you enable:
#     http://localhost/api/errands/auth/oauth/<provider>/callback
# ...replacing http://localhost with your public origin in production, and
# setting OAUTH_PUBLIC_BASE_URL to match.

# OAUTH_PUBLIC_BASE_URL=https://dyzah.co.ke

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
# OAUTH_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# OAUTH_GOOGLE_CLIENT_SECRET=

# Meta for Developers → your app → Facebook Login → Settings
# OAUTH_FACEBOOK_CLIENT_ID=
# OAUTH_FACEBOOK_CLIENT_SECRET=

# GitHub → Settings → Developer settings → OAuth Apps
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=

# Entra ID (Azure AD) → App registrations → multitenant
# OAUTH_MICROSOFT_CLIENT_ID=
# OAUTH_MICROSOFT_CLIENT_SECRET=

# ── M-Pesa (mock unless real Daraja creds are supplied) ──────────
# MPESA_MOCK=false
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
